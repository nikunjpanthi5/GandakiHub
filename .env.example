# ==============================================================================
# GandakiHub — Environment Variables Template
# Copy to .env for local development. NEVER commit real secrets to GitHub.
# ==============================================================================

# --- Runtime Environment ---
NODE_ENV="development"
PORT="3000"

# --- PostgreSQL Database (Supabase Free Pooler Connection String) ---
# Production (Render): Use your Supabase Session or Transaction pooler URI with ?sslmode=require.
# Local Dev: Leave blank to use the automatic embedded PostgreSQL (PGlite) database in ./.data/pglite.
DATABASE_URL=""
LOCAL_PGDATA_DIR="./.data/pglite"

# --- Supabase Private File Storage (Bucket: gandakihub-private) ---
# Production: Required. Retrieve Project URL & service_role key from Supabase Settings -> API.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="gandakihub-private"

# --- Resend Free-Tier Email Delivery (6-Digit OTP Codes) ---
# Production: Required. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="GandakiHub <onboarding@resend.dev>"

# --- Authentication, Sessions & Platform Ownership ---
# Generate with: openssl rand -hex 32 (minimum 32 characters required in production)
SESSION_SECRET=""
# Email allowed to complete initial one-time Super Admin bootstrap
SUPER_ADMIN_EMAIL="snikunj769@gmail.com"

# --- Cross-Origin CORS Allowlist (Vercel <-> Render) ---
# Comma-separated frontend URLs allowed to send credentialed API requests
# Example: https://gandakihub.vercel.app,https://gandakihub-customdomain.com
CORS_ORIGIN="http://localhost:3000"
ALLOW_VERCEL_PREVIEWS="false"

# --- Frontend Build Variable (Configured on Vercel) ---
# Production (Vercel): Set to your Render backend URL, e.g. https://gandakihub-api.onrender.com
# Same-origin local dev: Leave empty so relative /api/... requests resolve directly
VITE_API_URL=""

# --- Platform URL / Optional AI Capability ---
APP_URL="http://localhost:3000"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
