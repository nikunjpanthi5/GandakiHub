# GandakiHub Environment Configuration
# Copy to .env for local overrides (never commit real secrets).

# Application URL & Port
APP_URL="http://localhost:3000"
PORT=3000

# Session signing secret (generate with: openssl rand -hex 32)
# Auto-generated ephemeral fallback is used in local dev if omitted.
SESSION_SECRET="change-me-to-a-long-random-secret-in-production"

# Active Database: Node.js built-in SQLite (node:sqlite) with FTS5
# Automatically created on first boot at DATABASE_PATH; no external DB required to run locally.
DATABASE_PATH="./data/gandakihub.db"
PRIVATE_STORAGE_DIR="./storage/private_pdfs"
MAX_UPLOAD_MB=10

# First-Time Super Admin Bootstrap (Optional)
# When set and zero verified super_admin accounts exist, verifying this email via OTP promotes it to super_admin.
# If left empty, the Create Account form offers a one-time checkbox to initialize the first verified Super Admin.
SUPER_ADMIN_EMAIL=""

# Optional: Resend API for production 6-digit OTP email delivery (https://resend.com)
# When omitted in non-production, OTP codes are logged to the server console and returned in dev preview for verification.
RESEND_API_KEY=""
EMAIL_FROM="GandakiHub <noreply@gandakihub.example>"

# Optional: Supabase PostgreSQL + Storage (only needed if migrating to supabase/migrations/001_initial_schema.sql)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

